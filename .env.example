# Base de données PostgreSQL (Railway)
DATABASE_URL="postgresql://user:password@host:5432/buildflow"

# JWT — générer une valeur forte et aléatoire en production, ex: openssl rand -hex 32
JWT_SECRET="change-this-secret-in-production"
JWT_EXPIRES_IN="7d"

# Serveur
PORT=3000
NODE_ENV=development

# CORS — URL du frontend Angular
FRONTEND_URL="http://localhost:4200"

# Mot de passe par défaut créé lors de la création d'un compte utilisateur — à changer en production
DEFAULT_PASSWORD="change-this-default-password"

# ── Email SMTP (envoi des identifiants aux nouveaux utilisateurs) ──
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM="BuildFlow <your-email@gmail.com>"
